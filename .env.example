# Copy to .env for local development (optional — everything below has a
# working default for local dev if you leave .env out entirely).
# On Railway, set these under the web service's Variables tab instead.

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database (Postgres) ---
# On Railway use the reference ${{Postgres.DATABASE_URL}}.
# Leave unset to use local SQLite instead.
DATABASE_URL=postgres://user:password@host:5432/railway

# --- Media storage (Cloudinary) ---
# From your Cloudinary dashboard: Account Details > API Environment variable.
# Leave unset to store uploads on local disk instead.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- Initial admin account (used by `create_admin` in the pre-deploy command) ---
# Only needed the first deploy — safe to leave set afterward, since
# create_admin skips silently once this username already exists.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=you@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-to-something-strong

# --- Railway-specific (set automatically by Railway at runtime — no action needed) ---
# RAILWAY_PUBLIC_DOMAIN=web-production-xxxx.up.railway.app

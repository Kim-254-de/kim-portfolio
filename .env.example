# Copy to .env for local development (optional — everything below has a
# working default for local dev if you leave .env out entirely).
# On Render, set these as Environment Variables in the dashboard instead.

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database (Aiven Postgres) ---
# Get this from your Aiven service overview page ("Connection information").
# It already includes sslmode=require, which Aiven requires.
# Leave unset to use local SQLite instead.
DATABASE_URL=postgres://user:password@your-service.aivencloud.com:12345/defaultdb?sslmode=require

# --- Media storage (Cloudinary) ---
# From your Cloudinary dashboard: Account Details > API Environment variable.
# Leave unset to store uploads on local disk instead.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- Initial admin account (used by build.sh via `create_admin`) ---
# Only needed the first deploy — safe to leave set afterward, since
# create_admin skips silently once this username already exists.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=you@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-to-something-strong

# --- Render-specific (set automatically by Render at runtime — no action needed) ---
# RENDER_EXTERNAL_HOSTNAME=your-app.onrender.com
